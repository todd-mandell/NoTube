<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NoDate — Break the Validation Loop</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            500: '#f43f5e',
                            600: '#e11d48',
                            900: '#881337',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .card-stack {
            perspective: 1000px;
        }
        @keyframes pulse-slow {
            0%, 100% { opacity: 0.2; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.05); }
        }
        .animate-pulse-slow {
            animation: pulse-slow 8s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col selection:bg-brand-500 selection:text-white overflow-x-hidden">

    <header class="border-b border-zinc-900 bg-zinc-950/80 backdrop-blur-md sticky top-0 z-50 px-4 py-3">
        <div class="max-w-md mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-rose-400 flex items-center justify-center shadow-lg shadow-brand-500/20">
                    <i data-lucide="shield-heart" class="w-5 h-5 text-white"></i>
                </div>
                <div>
                    <h1 class="font-bold tracking-tight text-lg text-white flex items-center gap-1.5">
                        NoDate <span class="text-xs px-2 py-0.5 rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20 font-medium">Detox v1.0</span>
                    </h1>
                </div>
            </div>
            
            <nav class="flex items-center space-x-1">
                <button onclick="switchTab('cards')" id="nav-cards" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-brand-500 text-white shadow-sm flex items-center gap-1">
                    <i data-lucide="layers" class="w-3.5 h-3.5"></i> Cards
                </button>
                <button onclick="switchTab('stats')" id="nav-stats" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-zinc-400 hover:text-white hover:bg-zinc-900 flex items-center gap-1">
                    <i data-lucide="activity" class="w-3.5 h-3.5"></i> Detox
                </button>
                <button onclick="switchTab('simulator')" id="nav-simulator" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-zinc-400 hover:text-white hover:bg-zinc-900 flex items-center gap-1">
                    <i data-lucide="calculator" class="w-3.5 h-3.5"></i> Reality
                </button>
            </nav>
        </div>
    </header>

    <main class="flex-1 max-w-md w-full mx-auto p-4 flex flex-col justify-between relative">
        
        <!-- Background Ambient Glow -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 bg-brand-600/10 rounded-full blur-3xl pointer-events-none animate-pulse-slow"></div>

        <!-- TAB 1: CARD DECK (SWIPE MECHANIC) -->
        <div id="tab-cards" class="flex-1 flex flex-col justify-between py-2">
            <!-- Counter & Streak Header -->
            <div class="flex items-center justify-between text-xs text-zinc-400 px-1 mb-3">
                <span id="card-progress" class="font-medium text-zinc-300">Prompt 1 of 12</span>
                <span class="flex items-center gap-1 text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                    <i data-lucide="Flame" class="w-3 h-3"></i> <span id="streak-count">3</span> Day Detox Streak
                </span>
            </div>

            <!-- Swipe Card Container -->
            <div class="card-stack relative w-full h-[420px] my-auto flex items-center justify-center">
                <div id="active-card" class="absolute inset-0 w-full h-full bg-zinc-900/90 border border-zinc-800/80 rounded-3xl p-6 flex flex-col justify-between shadow-2xl backdrop-blur-xl transition-all duration-300 select-none">
                    <!-- Card Top Tag -->
                    <div class="flex items-center justify-between">
                        <span id="card-category" class="text-[11px] font-semibold tracking-wider uppercase px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 border border-zinc-700/50">
                            Validation Audit
                        </span>
                        <button onclick="openJournalModal()" class="text-zinc-400 hover:text-brand-400 p-1.5 rounded-full hover:bg-zinc-800/50 transition">
                            <i data-lucide="book-open-text" class="w-4 h-4"></i>
                        </button>
                    </div>

                    <!-- Card Content -->
                    <div class="my-auto py-4">
                        <h2 id="card-title" class="text-xl font-bold text-white mb-3 leading-snug">
                            Why do you feel the urge to open a dating app right now?
                        </h2>
                        <p id="card-subtitle" class="text-sm text-zinc-400 leading-relaxed">
                            Boredom, loneliness, anxiety, or seeking external self-worth after a long day? Name the root emotion without judgment.
                        </p>
                    </div>

                    <!-- Card Footer Prompt -->
                    <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between text-xs text-zinc-500">
                        <span class="flex items-center gap-1 text-brand-400">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i> Self-Worth Mirror
                        </span>
                        <span>Swipe Left to Bound / Right to Reflect</span>
                    </div>
                </div>
            </div>

            <!-- Action Controls (Tinder Style Buttons) -->
            <div class="flex items-center justify-center gap-6 mt-6 pb-2">
                <button onclick="handleSwipe('left')" class="w-16 h-16 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-rose-400 hover:bg-rose-500/10 hover:border-rose-500/30 transition-all shadow-lg active:scale-95 group">
                    <i data-lucide="x" class="w-7 h-7 group-hover:scale-110 transition-transform"></i>
                </button>
                <button onclick="handleSwipe('right')" class="w-16 h-16 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/30 transition-all shadow-lg active:scale-95 group">
                    <i data-lucide="heart" class="w-7 h-7 group-hover:scale-110 transition-transform"></i>
                </button>
            </div>
        </div>

        <!-- TAB 2: DETOX METRICS & VALIDATION METER -->
        <div id="tab-stats" class="hidden flex-1 flex flex-col space-y-4 py-2">
            <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-2xl p-5 backdrop-blur-md">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-sm font-semibold text-zinc-300">Validation Detox Timer</h3>
                    <span class="text-xs text-brand-400 font-medium bg-brand-500/10 px-2 py-0.5 rounded border border-brand-500/20">Active Fast</span>
                </div>
                <div class="text-3xl font-extrabold text-white tracking-tight mb-1" id="detox-timer">
                    72h : 41m : 12s
                </div>
                <p class="text-xs text-zinc-400">Time elapsed since seeking algorithmic romantic validation.</p>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 gap-3">
                <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-2xl p-4">
                    <div class="flex items-center justify-between text-zinc-400 mb-2">
                        <span class="text-xs font-medium">Boundaries Set</span>
                        <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i>
                    </div>
                    <div class="text-2xl font-bold text-white" id="stat-boundaries">14</div>
                    <span class="text-[10px] text-zinc-500">Swiped left on urges</span>
                </div>
                <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-2xl p-4">
                    <div class="flex items-center justify-between text-zinc-400 mb-2">
                        <span class="text-xs font-medium">Reflections Unlocked</span>
                        <i data-lucide="eye" class="w-4 h-4 text-brand-400"></i>
                    </div>
                    <div class="text-2xl font-bold text-white" id="stat-reflections">9</div>
                    <span class="text-[10px] text-zinc-500">Self-worth insights</span>
                </div>
            </div>

            <!-- Dopamine Reset Badge -->
            <div class="bg-gradient-to-br from-zinc-900 to-zinc-900/50 border border-zinc-800/80 rounded-2xl p-5">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
                        <i data-lucide="award" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-white">Dopamine Receptors: Recovering</h4>
                        <p class="text-xs text-zinc-400">Your brain is lowering baseline artificial validation needs.</p>
                    </div>
                </div>
                <div class="w-full bg-zinc-800 h-2 rounded-full overflow-hidden">
                    <div class="bg-gradient-to-r from-amber-500 to-brand-500 h-full w-3/4 rounded-full"></div>
                </div>
                <div class="flex justify-between items-center text-[10px] text-zinc-500 mt-1.5">
                    <span>Initial Spike</span>
                    <span>Neutral Baseline (75%)</span>
                </div>
            </div>
        </div>

        <!-- TAB 3: REALITY CHECK & PARADOX OF CHOICE CALCULATOR -->
        <div id="tab-simulator" class="hidden flex-1 flex flex-col space-y-4 py-2 overflow-y-auto">
            <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-2xl p-5 backdrop-blur-md">
                <div class="flex items-center gap-2 mb-2">
                    <i data-lucide="bar-chart-3" class="w-4 h-4 text-brand-400"></i>
                    <h3 class="text-sm font-semibold text-zinc-300">The Paradox of Choice Calculator</h3>
                </div>
                <p class="text-xs text-zinc-400 mb-4 leading-relaxed">
                    Dating apps market infinite abundance, but mathematical reality shows it creates decision fatigue and burnout. Test your stats:
                </p>

                <!-- Sliders -->
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-xs mb-1">
                            <span class="text-zinc-400">Minutes swiped per day:</span>
                            <span id="val-mins" class="font-bold text-white">45 mins</span>
                        </div>
                        <input type="range" min="5" max="180" value="45" class="w-full accent-brand-500 bg-zinc-800 rounded-lg h-1.5 cursor-pointer" id="slider-mins" oninput="updateCalculator()">
                    </div>
                    <div>
                        <div class="flex justify-between text-xs mb-1">
                            <span class="text-zinc-400">Months spent on apps:</span>
                            <span id="val-months" class="font-bold text-white">12 months</span>
                        </div>
                        <input type="range" min="1" max="60" value="12" class="w-full accent-brand-500 bg-zinc-800 rounded-lg h-1.5 cursor-pointer" id="slider-months" oninput="updateCalculator()">
                    </div>
                </div>
            </div>

            <!-- Calculated Exhaustion Card -->
            <div class="bg-zinc-900/90 border border-zinc-800/80 rounded-2xl p-5 space-y-3">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Real-World Equivalent Cost</h4>
                <div class="grid grid-cols-2 gap-3 pt-1">
                    <div class="bg-zinc-950/60 p-3 rounded-xl border border-zinc-800/50">
                        <div class="text-xl font-extrabold text-brand-400" id="calc-hours">270 hrs</div>
                        <div class="text-[11px] text-zinc-400 mt-0.5">Total Time Wasted</div>
                    </div>
                    <div class="bg-zinc-950/60 p-3 rounded-xl border border-zinc-800/50">
                        <div class="text-xl font-extrabold text-white" id="calc-profiles">14,400</div>
                        <div class="text-[11px] text-zinc-400 mt-0.5">Strangers Scanned</div>
                    </div>
                </div>
                <p class="text-xs text-zinc-500 italic pt-1 text-center" id="calc-quote">
                    "That is equivalent to reading 18 full-length books or mastering a musical instrument."
                </p>
            </div>
        </div>

    </main>

    <!-- SELF-WORTH REFLECTION MODAL -->
    <div id="reflection-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-zinc-900 border border-zinc-800 rounded-3xl max-w-sm w-full p-6 shadow-2xl relative animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2 text-brand-400 font-semibold text-sm">
                    <i data-lucide="sparkles" class="w-4 h-4"></i> Self-Worth Insight
                </div>
                <button onclick="closeReflectionModal()" class="text-zinc-400 hover:text-white p-1">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            <div id="modal-content" class="text-sm text-zinc-300 leading-relaxed mb-6 space-y-3">
                <!-- Dynamically populated insight -->
            </div>
            <button onclick="closeReflectionModal()" class="w-full py-3 bg-brand-600 hover:bg-brand-500 text-white font-semibold rounded-xl text-sm transition shadow-lg shadow-brand-600/20">
                Integrate & Continue
            </button>
        </div>
    </div>

    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        // App State
        let currentCardIndex = 0;
        let boundariesCount = 14;
        let reflectionsCount = 9;

        const cardsData = [
            {
                category: "Validation Audit",
                title: "Why do you feel the urge to open a dating app right now?",
                subtitle: "Boredom, loneliness, anxiety, or seeking external self-worth after a long day? Name the root emotion without judgment."
            },
            {
                category: "Illusion Reality Check",
                title: "Are you swiping for a genuine connection or for a micro-dose of instant dopamine?",
                subtitle: "Recognize that a match notification triggers the exact same neural reward loop as a slot machine spin."
            },
            {
                category: "Self-Worth Mirror",
                title: "What quality do you possess that no swipe or match can ever validate or take away?",
                subtitle: "Your intrinsic worth is complete. External approval is a luxury, not a life-support system."
            },
            {
                category: "Boundary Setting",
                title: "How often do you settle for half-interested texters just to avoid sitting in silence?",
                subtitle: "True peace is vastly superior to the chronic anxiety of ambiguous digital breadcrumbing."
            },
            {
                category: "Expectation Audit",
                title: "Are you expecting an app to heal an internal feeling of emptiness or boredom?",
                subtitle: "External relationships amplify who you already are; they cannot rescue you from yourself."
            },
            {
                category: "Pattern Breaker",
                title: "What is one offline hobby or creative pursuit you neglected this week for a glowing screen?",
                subtitle: "Channel that romantic energy back into building a life you are passionately in love with."
            },
            {
                category: "Rejection Immunity",
                title: "Why does being left on read feel like a personal indictment on your character?",
                subtitle: "Stranger ghosting reflects their emotional unavailability and capacity, not your worth or beauty."
            },
            {
                category: "Mindful Presence",
                title: "Take three deep breaths. What does your body actually need right now?",
                subtitle: "Water, stretching, a walk outside, or genuine human connection with a close friend?"
            }
        ];

        const insightsData = [
            "🧠 **Neuroscience Fact:** Swiping creates a variable reward schedule. Your brain releases dopamine not upon matching, but in anticipation of the *next* potential swipe.",
            "🪞 **The Mirror Rule:** When we seek constant validation from strangers online, we are usually attempting to outsource self-acceptance we haven't given ourselves.",
            "🛡️ **Boundary Strength:** Swiping left isn't rejection—it's radical alignment with your own time, energy, and emotional bandwidth.",
            "⏳ **Time Sovereignty:** Reclaiming 45 minutes a day from swiping gives you over 270 hours a year to invest in mastery, health, and deep friendships."
        ];

        function switchTab(tabId) {
            ['cards', 'stats', 'simulator'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
                document.getElementById(`nav-${t}`).className = "px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-zinc-400 hover:text-white hover:bg-zinc-900 flex items-center gap-1";
            });
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            document.getElementById(`nav-${tabId}`).className = "px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-brand-500 text-white shadow-sm flex items-center gap-1";
            lucide.createIcons();
        }

        function renderCard() {
            const card = cardsData[currentCardIndex % cardsData.length];
            document.getElementById('card-category').innerText = card.category;
            document.getElementById('card-title').innerText = card.title;
            document.getElementById('card-subtitle').innerText = card.subtitle;
            document.getElementById('card-progress').innerText = `Prompt ${(currentCardIndex % cardsData.length) + 1} of ${cardsData.length}`;
        }

        function handleSwipe(direction) {
            const cardEl = document.getElementById('active-card');
            
            // Swipe animation effect
            cardEl.style.transform = direction === 'left' ? 'translateX(-120px) rotate(-15deg)' : 'translateX(120px) rotate(15deg)';
            cardEl.style.opacity = '0';

            setTimeout(() => {
                if (direction === 'right') {
                    reflectionsCount++;
                    document.getElementById('stat-reflections').innerText = reflectionsCount;
                    openJournalModal();
                } else {
                    boundariesCount++;
                    document.getElementById('stat-boundaries').innerText = boundariesCount;
                }

                currentCardIndex++;
                renderCard();

                // Reset card position
                cardEl.style.transition = 'none';
                cardEl.style.transform = 'translateX(0) rotate(0)';
                setTimeout(() => {
                    cardEl.style.transition = 'all 0.3s ease';
                    cardEl.style.opacity = '1';
                }, 50);
            }, 250);
        }

        function openJournalModal() {
            const randomInsight = insightsData[Math.floor(Math.random() * insightsData.length)];
            document.getElementById('modal-content').innerHTML = `<p>${randomInsight}</p>`;
            document.getElementById('reflection-modal').classList.remove('hidden');
            document.getElementById('reflection-modal').classList.add('flex');
        }

        function closeReflectionModal() {
            document.getElementById('reflection-modal').classList.remove('flex');
            document.getElementById('reflection-modal').classList.add('hidden');
        }

        function updateCalculator() {
            const mins = document.getElementById('slider-mins').value;
            const months = document.getElementById('slider-months').value;

            document.getElementById('val-mins').innerText = `${mins} mins`;
            document.getElementById('val-months').innerText = `${months} months`;

            const totalHours = Math.round((mins * 30 * months) / 60);
            const totalProfiles = Math.round(mins * 8 * 30 * months);

            document.getElementById('calc-hours').innerText = `${totalHours} hrs`;
            document.getElementById('calc-profiles').innerText = totalProfiles.toLocaleString();
        }

        // Live Detox Timer simulation
        let seconds = 27792; // ~7 hours
        setInterval(() => {
            seconds++;
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            const s = seconds % 60;
            document.getElementById('detox-timer').innerText = `${h}h : ${m < 10 ? '0':''}${m}m : ${s < 10 ? '0':''}${s}s`;
        }, 1000);

        // Initial render
        renderCard();
    </script>
</body>
</html>
